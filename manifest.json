{
  "manifest_version": 3,
  "name": "YT Local Player",
  "version": "1.0",
  "description": "Substitui o vídeo do YouTube pelo teu ficheiro local, mantendo toda a interface intacta.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir vídeo local no YouTube"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
